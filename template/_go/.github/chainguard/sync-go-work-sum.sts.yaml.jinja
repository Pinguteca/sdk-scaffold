issuer: https://token.actions.githubusercontent.com
# Pull request runs from branches in this repo only. Fork PRs never get an
# OIDC token, so they cannot reach this policy.
subject_pattern: "^repo:{{ github_owner }}/{{ project_name }}:pull_request$"
claim_pattern:
  workflow_ref: "{{ github_owner }}/{{ project_name }}/\\.github/workflows/sync-go-work-sum\\.yml@refs/pull/[0-9]+/merge"
permissions:
  contents: write
