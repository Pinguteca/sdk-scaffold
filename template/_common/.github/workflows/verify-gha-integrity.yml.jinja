name: Verify GHA Integrity

on:
  push:
    branches: [main]
    paths: [".github/workflows/**"]
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
    branches: [main]
    paths: [".github/workflows/**"]

permissions: {}

concurrency:
  group: {{ '${{ github.workflow }}-${{ github.ref }}' }}
  cancel-in-progress: true

jobs:
  verify:
    name: Verify pinned action SHAs
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      id-token: write
      contents: write
    steps:
{% if harden_runner %}
      - name: Harden Runner
        uses: step-security/harden-runner@f808768d1510423e83855289c910610ca9b43176 # v2.17.0
        with:
          egress-policy: audit
          disable-telemetry: "true"
          disable-sudo-and-containers: "true"
{% endif %}
      - name: Obtain token
        id: octo-sts
        uses: octo-sts/action@f603d3be9d8dd9871a265776e625a27b00effe05 # v1.1.1
        with:
          scope: {{ github_owner }}/{{ project_name }}
          identity: verify-gha-integrity
      - name: Checkout
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          # Check out the branch itself, not the PR merge commit, so a
          # regenerated lockfile can be pushed back to it.
          ref: {{ '${{ github.head_ref || github.ref_name }}' }}
          # Keep the token out of .git/config; only the push step gets it.
          persist-credentials: false
          token: {{ '${{ steps.octo-sts.outputs.token }}' }}
      - name: Verify lockfile
        uses: gjtorikian/gh-actions-lockfile@v1.2.1
        with:
          mode: verify
      - name: Regenerate lockfile on failure
        if: failure()
        uses: gjtorikian/gh-actions-lockfile@v1.2.1
        with:
          mode: generate
      - name: Commit regenerated lockfile
        if: failure()
        env:
          TOKEN: {{ '${{ steps.octo-sts.outputs.token }}' }}
          BRANCH: {{ '${{ github.head_ref || github.ref_name }}' }}
        run: |
          git add -- .github/actions.lock.json
          git diff --cached --quiet && exit 0
          git -c user.name="github-actions[bot]" \
            -c user.email="41898349+github-actions[bot]@users.noreply.github.com" \
            commit -m "ci: regenerate .github/actions.lock.json [skip ci]"
          auth=$(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)
          echo "::add-mask::${auth}"
          git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic ${auth}" \
            push origin "HEAD:refs/heads/${BRANCH}"
