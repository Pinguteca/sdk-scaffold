{# Trust only the release workflows this repo renders. #}
{% set langs = languages[0] if languages|length == 1 else '(' ~ languages|join('|') ~ ')' %}
issuer: https://token.actions.githubusercontent.com
subject_pattern: "repo:{{ github_owner }}/{{ project_name }}:ref:refs/tags/v.*"
claim_pattern:
  workflow_ref: "{{ github_owner }}/{{ project_name }}/\\.github/workflows/release-{{ langs }}\\.yml@refs/tags/v.*"
permissions:
  contents: write
